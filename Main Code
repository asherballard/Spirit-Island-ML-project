def blight(land, Blight_Pool, Blighted, Invader_array, Fear_deck):
    if land.get_prescence():
        land.modify(0, 0, 0, 0, 1, -1)
    else:
        land.modify(0, 0, 0, 0, 1, 0)
    end_check(Blight_Pool, Blighted, Invader_array, Fear_deck)
    if land.get_blight() > 1:
        cascade = input("Where will you cascade?")
        blight(cascade)

