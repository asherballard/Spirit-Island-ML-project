class Land:
    def __init__(self, number, terrain, setup, adjacencies, coastal, token, board):
        self.number = number
        self.terrain = terrain
        self.setup = setup
        self.adjacancies = adjacencies
        self.coastal = coastal
        self.token = token
        self.board = board
        self.tokens_array = []
        self.dahan = 0
        self.explorer = 0
        self.town = 0
        self.city = 0
        self.blight = 0
        self.prescence = 0
        self.defense = 0


    def modify(self, dahan, explorer, town, city, blight, prescence, token_array):
        self.dahan += dahan
        self.explorer += explorer
        self.town += town
        self.city += city
        self.blight += blight
        self.prescence += prescence
        self.tokens_array += token_array

    def build_difference(self):
        return self.city > self.town

    def get_adjacencies(self):
        return self.adjacancies

    def get_invaders(self):
        return [self.explorer, self.town, self.city]

    def get_defense(self):
        return self.defense

    def get_dahan(self):
        return self.dahan

    def get_prescence(self):
        return self.prescence

    def get_blight(self):
        return self.blight

    def get_coastal(self):
        return self.coastal


def setup(Board_Letter, Spirit, Adversary):
    board = Board()
    if Board_Letter == "A":
        board.Board_A()
    elif Board_Letter == "B":
        board.Board_B()
    elif Board_Letter == "C":
        board.Board_C()
    else:
        board.Board_D()
    Invaders = Invader_Deck()
    return board, Invaders


def turn(Board, Invader_Deck, Invader_Turn, Adversary, Blight_Pool, Blighted, Invader_array, Fear_deck):
    spirit_phase()
    fast_phase()
    end_check(Blight_Pool, Blighted, Invader_array, Fear_deck)
    invader_phase(Board, Invader_Turn, Adversary, Blight_Pool, Blighted, Invader_array, Fear_deck)
    slow_phase()
    end_check(Blight_Pool, Blighted, Invader_array, Fear_deck)

def spirit_phase(Spirits):
    for x in Spirits:
        x.spirit_phase()


def fast_phase(Spirits):
    for x in Spirits:
        for y in x.get_power_turn():
            x.play_card(y)


def invader_phase(Board, Invader_Turn, Adversary, Blight_Pool, Blighted, Invader_array, Fear_deck):
    ravage(Board, Invader_Turn[0], Adversary, Blight_Pool, Blighted, Invader_array, Fear_deck)
    build(Board, Invader_Turn[1], Adversary)
    explore(Board, Invader_Turn[2], Adversary)

def ravage(Board, Invader_Turn, Adversary, Blight_Pool, Blighted, Invader_array, Fear_deck):
    if Invader_Turn:
        for x in Invader_Turn:
            if has_invaders(x):
                invaders = x.get_invaders()
                if invaders[0] + (2 * invaders[1]) + (3 * invaders[2]) - x.get_defense() > 1:
                    blight(x, Blight_Pool, Blighted, Invader_array, Fear_deck)
                dahan_counterattack(Board, Land, x.get_dahan*2)
    end_check(Blight_Pool, Blighted, Invader_array, Fear_deck)

def dahan_counterattack(Board, Land, Number):
    for x in range(Number):
        Index = input("What do you want to damage?")
        user_damage_one(Board, Land, Index)

def build(Board, Invader_Turn, Adversary):
    if Invader_Turn:
        for x in Invader_Turn:
            if has_invaders(x):
                if x.build_difference():
                    x.modify(0, 0, 1, 0, 0, 0, [Town()])
                else:
                    x.modify(0, 0, 0, 1, 0, 0, [City()])


def explore(Board, Invader_Turn, Adversary):
    if Invader_Turn:
        for x in Invader_Turn:
            for y in x.get_adjacencies():
                if y:
                    x.modify(1, 0, 0, 0, 0, 0, [Explorer()])
                    break
    else:
        game_over(False)

